<%- include('partials/header', { title: 'Change Password', currentUser }) %>

<div class="section-title-row">
  <div>
    <h1>Change password</h1>
    <p class="subtitle">Update your own admin login password.</p>
  </div>
</div>

<div class="card">
  <form method="POST" action="/me/password">
    <div class="field"><label>Current password</label><input type="password" name="currentPassword" required style="width:100%;" /></div>
    <div class="field"><label>New password</label><input type="password" name="newPassword" required style="width:100%;" /></div>
    <button class="btn secondary" type="submit">Update password</button>
  </form>
</div>

<%- include('partials/footer') %>
